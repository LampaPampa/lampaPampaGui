local SectionVisual = TabVisual:NewSection("Подсветка")

SectionVisual:NewButton("Highlight Monsters", "Подсветка монстров красным", function()
    spawn(function()
        while wait(0.5) do
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj.Name:find("Monster") or obj.Name:find("Blue") or obj.Name:find("Green") or obj.Name:find("Red") or obj.Name:find("Yellow") or obj.Name:find("Orange") then
