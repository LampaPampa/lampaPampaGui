-- ========== ВКЛАДКА AUTO (Автоматизация) ==========
local TabAuto = Window:NewTab("🤖 Автоматизация")

local SectionAuto = TabAuto:NewSection("Авто-сбор")

local autoCollectActive = false
local autoCollectThread = nil

SectionAuto:NewButton("Auto-Farm Items", "Авто-сбор предметов (вкл/выкл)", function()
    autoCollectActive = not autoCollectActive
    
    if autoCollectActive then
        autoCollectThread = spawn(function()
            while autoCollectActive do
                local root = game.Players.LocalPlayer.Character.HumanoidRootPart
                local nearest = nil
                local minDist = math.huge
                
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and (obj.Name:find("LightBulb") or obj.Name:find("Canister") or obj.Name:find("Lukis") or obj.Name:find("Sugar")) then
                        local dist = (root.Position - obj.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            nearest = obj
                        end
                    end
                end
                
                if nearest then
                    root.CFrame = CFrame.new(nearest.Position) + Vector3.new(0, 2, 0)
                end
                wait(0.3)
            end
        end)
    else
        if autoCollectThread then task.cancel(autoCollectThread) end
    end
end)

SectionAuto:NewButton("Auto-Delivery", "Авто-сдача предметов", function()
    local deliverySpot = nil
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:find("Delivery") or obj.Name:find("Drop") then
            deliverySpot = obj
            break
        end
    end
    if deliverySpot then
        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(deliverySpot.Position)
    end
end)

-- ========== ВКЛАДКА FUN (Весёлое) ==========
local TabFun = Window:NewTab("🎮 Весёлое")

local SectionFun = TabFun:NewSection("Троллинг")

SectionFun:NewButton("Fling Player", "Кидать другого игрока", function()
    local target = nil
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= game.Players.LocalPlayer then
            target = plr
            break
        end
    end
    if target and target.Character and target.Character.HumanoidRootPart then
        local root = game.Players.LocalPlayer.Character.HumanoidRootPart
        local targetRoot = target.Character.HumanoidRootPart
        root.CFrame = targetRoot.CFrame
        local bv = Instance.new("BodyVelocity", targetRoot)
        bv.MaxForce = Vector3.new(100000, 100000, 100000)
        bv.Velocity = Vector3.new(100000, 100000, 100000)
        wait(0.2)
        bv:Destroy()
    end
end)

SectionFun:NewButton("Freeze Player", "Заморозить другого игрока", function()
    local target = nil
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= game.Players.LocalPlayer then
            target = plr
            break
        end
    end
    if target and target.Character then
        for _, part in pairs(target.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = true
            end
        end
    end
end)

SectionFun:NewButton("Invisible", "Сделать себя невидимым", function()
    for _, part in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 1
        end
    end
end)

SectionFun:NewButton("Fake Disconnect", "Имитировать выход из игры", function()
