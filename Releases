-- ========== ВКЛАДКА MAIN (Движение) ==========
local TabMove = Window:NewTab("🏃 Движение")

local SectionMove = TabMove:NewSection("Скорость и прыжки")

SectionMove:NewTextBox("Скорость (WalkSpeed)", "Введи число", function(txt)
    local speed = tonumber(txt)
    if speed then
        game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = speed
    end
end)

SectionMove:NewSlider("WalkSpeed", "Ползунок скорости", 500, 16, function(s)
    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = s
end)

SectionMove:NewSlider("JumpPower", "Высота прыжка", 500, 50, function(s)
    game.Players.LocalPlayer.Character.Humanoid.JumpPower = s
end)

SectionMove:NewButton("Auto-Walk", "Автоматический шаг вперёд", function()
    local humanoid = game.Players.LocalPlayer.Character.Humanoid
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(100000, 0, 100000)
    bodyVelocity.Velocity = humanoid.RootPart.CFrame.LookVector * 16
    bodyVelocity.Parent = humanoid.RootPart
    wait(0.1)
    bodyVelocity:Destroy()
end)

SectionMove:NewButton("Instant Dash", "Рывок вперёд на 10 метров", function()
    local root = game.Players.LocalPlayer.Character.HumanoidRootPart
    root.CFrame = root.CFrame + root.CFrame.LookVector * 10
end)

local noclipActive = false
local noclipConnection = nil
SectionMove:NewButton("Noclip Mode", "Хождение сквозь стены (вкл/выкл)", function()
    noclipActive = not noclipActive
    if noclipActive then
        noclipConnection = game:GetService("RunService").Stepped:Connect(function()
            if game.Players.LocalPlayer.Character then
                for _, part in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConnection then noclipConnection:Disconnect() end
    end
end)

SectionMove:NewButton("Ladder Speed", "Мгновенный подъём по лестницам", function()
    local humanoid = game.Players.LocalPlayer.Character.Humanoid
    humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
        if humanoid:GetState() == Enum.HumanoidStateType.Climbing then
            humanoid.RootPart.Velocity = Vector3.new(0, 50, 0)
        end
    end)
end)

SectionMove:NewButton("Air Jump", "Бесконечные прыжки в воздухе", function()
    local humanoid = game.Players.LocalPlayer.Character.Humanoid
    local jumpCount = 0
    humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
        if humanoid.Jump then
            jumpCount = jumpCount + 1
            if jumpCount > 1 then
                humanoid.Jump = true
            end
        end
    end)
end)

