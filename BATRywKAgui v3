	radar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	radar.BackgroundTransparency = 0.3
	radar.BorderSizePixel = 2
	radar.BorderColor3 = Color3.fromRGB(0, 255, 0)
	radar.Parent = gui

	local dots = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local dot = Instance.new("Frame")
			dot.Size = UDim2.new(0, 4, 0, 4)
			dot.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			dot.BackgroundTransparency = 0
			dot.Parent = radar
			dots[p] = dot
		end
	end

	task.spawn(function()
		while radar and radar.Parent do
			local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local center = Vector2.new(75, 75)
				for p, dot in pairs(dots) do
					local char = p.Character
					if char and char:FindFirstChild("HumanoidRootPart") then
						local delta = char.HumanoidRootPart.Position - hrp.Position
						local angle = math.atan2(delta.Z, delta.X)
						local dist = math.min(delta.Magnitude / 50, 70)
						local x = center.X + math.sin(angle) * dist
						local z = center.Y + math.cos(angle) * dist
						dot.Position = UDim2.new(0, x - 2, 0, z - 2)
						dot.Visible = true
					else
						dot.Visible = false
					end
				end
			end
			task.wait(0.05)
		end
	end)

	radar.ChildRemoved:Connect(function()
		if radar.Parent then radar:Destroy() end
	end)
end)

