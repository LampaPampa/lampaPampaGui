local pages = {}
local currentPage = 1


for p = 1, 5 do
	pages[p] = {}
	for s = 1, 10 do
		pages[p][s] = { Name = "", Func = nil }
	end
end


function NewSection(pageNumber, slotIndex, scriptName, callbackFunc)
	local p = tonumber(pageNumber)
	local s = tonumber(slotIndex)
	if pages[p] and pages[p][s] then
		pages[p][s].Name = scriptName
		pages[p][s].Func = callbackFunc
	end
end


local function updateGrid()
	local pageData = pages[currentPage]
	for i, cell in ipairs(gridSlots) do
		local slotData = pageData[i]
		if slotData and slotData.Func ~= nil then
			cell.Text = slotData.Name ~= "" and slotData.Name or "Script " .. i
			cell.BackgroundTransparency = 0
		else
			cell.Text = ""
			cell.BackgroundTransparency = 0.6
		end
	end
end

for i, cell in ipairs(gridSlots) do
	cell.MouseButton1Click:Connect(function()
		local slotData = pages[currentPage][i]
		if slotData and slotData.Func then
			local success, err = pcall(slotData.Func)
			if not success then warn("Execution error in slot " .. i .. ": " .. tostring(err)) end
		end
	end)
end

navLeft.MouseButton1Click:Connect(function()
	if currentPage > 1 then currentPage = currentPage - 1 updateGrid() end
end)

navRight.MouseButton1Click:Connect(function()
	if currentPage < #pages then currentPage = currentPage + 1 updateGrid() end
end)


local settingsOpen = false
local isTweening = false

sidebar.MouseButton1Click:Connect(function()
	if isTweening then return end
	isTweening = true
	settingsOpen = not settingsOpen

	local targetPos = settingsOpen and UDim2.new(1, 45, 0, 0) or UDim2.new(1, -250, 0, 0)
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(settingsFrame, tweenInfo, {Position = targetPos})

	tween:Play()
	tween.Completed:Connect(function()
		sidebar.Text = settingsOpen and "<" or ">"
		isTweening = false
	end)
end)


