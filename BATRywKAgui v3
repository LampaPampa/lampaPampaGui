local pages = {}
local currentPage = 1

for p = 1, 3 do
    pages[p] = { Left = {}, Right = {} }
    for s = 1, 14 do pages[p].Left[s] = { Name = "", Func = nil } end
    for s = 1, 10 do pages[p].Right[s] = { Name = "", Func = nil } end
end

function NewSection(pageNumber, slotIndex, scriptName, callbackFunc)
    local p = tonumber(pageNumber)
    local s = tonumber(slotIndex)
    if pages[p] then
        if s >= 1 and s <= 14 then
            pages[p].Left[s] = { Name = scriptName, Func = callbackFunc }
        elseif s >= 15 and s <= 24 then
            pages[p].Right[s - 14] = { Name = scriptName, Func = callbackFunc }
        end
    end
end

local function updateGrid()
    local pageData = pages[currentPage]
    for i, cell in ipairs(leftSlots) do
        local slotData = pageData.Left[i]
        if slotData and slotData.Func ~= nil then
            cell.Text = slotData.Name ~= "" and slotData.Name or "Script " .. i
            cell.BackgroundTransparency = 0
        else
            cell.Text = "Empty"
            cell.BackgroundTransparency = 0.5
        end
    end
    for i, cell in ipairs(rightSlots) do
        local slotData = pageData.Right[i]
        if slotData and slotData.Func ~= nil then
            cell.Text = slotData.Name ~= "" and slotData.Name or "Script " .. (i + 14)
            cell.BackgroundTransparency = 0
        else
            cell.Text = "Empty"
            cell.BackgroundTransparency = 0.5
        end
    end
    categoryLeft.Text = "Page " .. currentPage .. " - Left"
    categoryRight.Text = "Page " .. currentPage .. " - Right"
end

for i, cell in ipairs(leftSlots) do
    cell.MouseButton1Click:Connect(function()
        local slotData = pages[currentPage].Left[i]
        if slotData and slotData.Func then pcall(slotData.Func) end
    end)
end

for i, cell in ipairs(rightSlots) do
    cell.MouseButton1Click:Connect(function()
        local slotData = pages[currentPage].Right[i]
        if slotData and slotData.Func then pcall(slotData.Func) end
    end)
end

navLeft.MouseButton1Click:Connect(function()
    if currentPage > 1 then currentPage = currentPage - 1 updateGrid() end
end)

navRight.MouseButton1Click:Connect(function()
    if currentPage < 3 then currentPage = currentPage + 1 updateGrid() end
end)

