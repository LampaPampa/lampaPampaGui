local function scanForBackdoors()
	print("[SCANNER] Starting backdoor scan...")
	foundBackdoorsList = {}
	backdoorsFound = false

	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Players = game:GetService("Players")
	local Workspace = game:GetService("Workspace")

	local patterns = {
		"require(%d+)", "loadstring", "getfenv", "setfenv", "fireserver",
		"invokeserver", "HttpService:", "Kick", "Ban", "Admin", "Backdoor",
		"RemoteEvent", "RemoteFunction", "FireServer", "InvokeServer"
	}

	local function scanContainer(container, path)
		for _, obj in pairs(container:GetChildren()) do
			local currentPath = path .. "/" .. obj.Name

			if obj:IsA("Script") or obj:IsA("ModuleScript") or obj:IsA("LocalScript") then
				pcall(function()
					local src = obj.Source
					for _, pattern in pairs(patterns) do
						if string.find(src, pattern) then
							local info = "[BACKDOOR] Found in " .. currentPath .. " | Pattern: " .. pattern
							table.insert(foundBackdoorsList, info)
							print(info)
							break
						end
					end
				end)
			end

			if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
				local nameLower = string.lower(obj.Name)
				if string.find(nameLower, "admin") or string.find(nameLower, "kick") or string.find(nameLower, "ban") or string.find(nameLower, "cmd") or string.find(nameLower, "exec") then
					local info = "[REMOTE] Found vulnerable: " .. currentPath
					table.insert(foundBackdoorsList, info)
					print(info)
				end
			end

			scanContainer(obj, currentPath)
		end
	end

	scanContainer(ReplicatedStorage, "ReplicatedStorage")
	scanContainer(Players, "Players")
	scanContainer(Workspace, "Workspace")

	print("=" .. string.rep("=", 50))
	if #foundBackdoorsList > 0 then
		backdoorsFound = true
		print("[RESULT] Backdoors found: " .. #foundBackdoorsList)
		for i, item in pairs(foundBackdoorsList) do
			print("  " .. i .. ". " .. item)
		end
		print("[RESULT] Filling slots 5-9")

		updatePage9Slot(5, "🔥 FE KICK ALL", feKickAll)
		updatePage9Slot(6, "🗑️ FE DELETE WORKSPACE", feDeleteWorkspace)
		updatePage9Slot(7, "🎨 FE DECAL SPAM", feDecalSpam)
		updatePage9Slot(8, "💀 FE CRASH SERVER", feCrashServer)
		updatePage9Slot(9, "🐌 FE SERVER LAG", feServerLag)
	else
		backdoorsFound = false
		print("[RESULT] No backdoors found")
		print("[RESULT] Slots 5-9 remain empty")

		for i = 5, 9 do
			updatePage9Slot(i, "Empty", nil)
		end
	end
	print("=" .. string.rep("=", 50))
end

