NewSection(3, 9, "🌀 FE KAWAI VORTEX", function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local radius = 20
    local height = 5
    local speed = 8
    
    -- Поиск незакреплённых объектов
    local objects = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "Terrain" then
            if not obj:IsDescendantOf(char) and not obj.Anchored then
                local dist = (obj.Position - hrp.Position).Magnitude
                if dist < radius then
                    table.insert(objects, obj)
                end
            end
        end
    end
    
    if #objects == 0 then
        print("[VORTEX] No unanchored objects nearby")
        return
    end
    
    -- Привязываем к каждому объекту BodyVelocity и BodyGyro
    local velocities = {}
    local gyros = {}
    
    for _, obj in pairs(objects) do
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = obj
        velocities[obj] = bv
        
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.Parent = obj
        gyros[obj] = bg
    end
    
    local angle = 0
    local center = hrp
    local connection
    
    connection = RunService.RenderStepped:Connect(function()
        if not center or not center.Parent then
            if connection then connection:Disconnect() end
            return
        end
        
        local centerPos = center.Position
        angle = angle + math.rad(speed)
        
        for i, obj in pairs(objects) do
            if obj and obj.Parent then
                local origPos = obj.Position
                local dir = (origPos - centerPos).Unit
                local dist = (origPos - centerPos).Magnitude
                
                local newX = centerPos.X + math.cos(angle + i) * dist
                local newZ = centerPos.Z + math.sin(angle + i) * dist
                local newY = centerPos.Y + height + math.sin(angle * 2 + i) * 1.5
                
                local newPos = Vector3.new(newX, newY, newZ)
                local velocity = (newPos - origPos) / 0.05
                
                if velocities[obj] then
                    velocities[obj].Velocity = velocity
                end
                
                if gyros[obj] then
                    gyros[obj].AngularVelocity = Vector3.new(0, 10, 5)
                    gyros[obj].CFrame = CFrame.new(obj.Position, centerPos)
                end
            end
        end
    end)
    
    -- Остановка через 30 секунд
    task.delay(30, function()
        if connection then connection:Disconnect() end
        for _, bv in pairs(velocities) do
            pcall(function() bv:Destroy() end)
        end
        for _, bg in pairs(gyros) do
            pcall(function() bg:Destroy() end)
        end
        print("[VORTEX] Stopped")
    end)
    
    print("[VORTEX] FE Vortex started (" .. #objects .. " objects)")
end)

