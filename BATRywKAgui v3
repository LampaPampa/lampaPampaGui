NewSection(6, 6, "Aimbot (Silent)", function()
	local mouse = LocalPlayer:GetMouse()
	local target = nil
	local function getClosest()
		local closest = nil
		local minDist = math.huge
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local pos, on = workspace.CurrentCamera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
				if on then
					local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
					if dist < minDist and dist < 200 then
						minDist = dist
						closest = p
					end
				end
			end
		end
		return closest
	end
	mouse.Button1Down:Connect(function()
		target = getClosest()
		if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
			local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
			if tool and tool:FindFirstChild("Handle") then
				tool.Handle.CFrame = CFrame.new(tool.Handle.Position, target.Character.HumanoidRootPart.Position)
			end
			target.Character.Humanoid.Health = target.Character.Humanoid.Health - 50
		end
	end)
end)

